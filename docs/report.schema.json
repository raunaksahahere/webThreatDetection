     "type": "string"
    },
    "provider": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Provider"
    },
    "model": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Model"
    },
    "latency_ms": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Latency Ms"
    },
    "summary": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Summary"
    },
    "points": {
     "items": {
      "$ref": "#/$defs/AIPoint"
     },
     "title": "Points",
     "type": "array"
    },
    "observations": {
     "items": {
      "$ref": "#/$defs/AIObservation"
     },
     "title": "Observations",
     "type": "array"
    },
    "recommended_actions": {
     "items": {
      "type": "string"
     },
     "title": "Recommended Actions",
     "type": "array"
    },
    "uncertainty": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Uncertainty"
    },
    "injection_attempt_observed": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Injection Attempt Observed"
    },
    "validation_notes": {
     "items": {
      "type": "string"
     },
     "title": "Validation Notes",
     "type": "array"
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Error"
    }
   },
   "required": [
    "status"
   ],
   "title": "AIResult",
   "type": "object"
  },
  "Assessment": {
   "additionalProperties": false,
   "properties": {
    "classification": {
     "$ref": "#/$defs/Classification"
    },
    "rule_id": {
     "title": "Rule Id",
     "type": "string"
    },
    "rule_text": {
     "title": "Rule Text",
     "type": "string"
    },
    "basis_finding_ids": {
     "items": {
      "type": "string"
     },
     "title": "Basis Finding Ids",
     "type": "array"
    },
    "rationale": {
     "items": {
      "type": "string"
     },
     "title": "Rationale",
     "type": "array"
    },
    "contradictions": {
     "items": {
      "type": "string"
     },
     "title": "Contradictions",
     "type": "array"
    },
    "coverage": {
     "$ref": "#/$defs/Coverage"
    }
   },
   "required": [
    "classification",
    "rule_id",
    "rule_text",
    "basis_finding_ids",
    "rationale",
    "contradictions",
    "coverage"
   ],
   "title": "Assessment",
   "type": "object"
  },
  "CheckResult": {
   "additionalProperties": false,
   "properties": {
    "name": {
     "description": "e.g. 'intel.urlhaus', 'tls.handshake'",
     "title": "Name",
     "type": "string"
    },
    "module": {
     "$ref": "#/$defs/Module"
    },
    "status": {
     "$ref": "#/$defs/CheckStatus"
    },
    "essential": {
     "description": "Essential checks gate Low Risk; missing ones force Inconclusive",
     "title": "Essential",
     "type": "boolean"
    },
    "detail": {
     "default": "",
     "title": "Detail",
     "type": "string"
    },
    "duration_ms": {
     "default": 0,
     "title": "Duration Ms",
     "type": "integer"
    }
   },
   "required": [
    "name",
    "module",
    "status",
    "essential"
   ],
   "title": "CheckResult",
   "type": "object"
  },
  "CheckStatus": {
   "enum": [
    "succeeded",
    "failed",
    "unavailable",
    "skipped",
    "not_implemented"
   ],
   "title": "CheckStatus",
   "type": "string"
  },
  "Classification": {
   "enum": [
    "Low Risk",
    "Suspicious",
    "High Risk",
    "Confirmed Malicious",
    "Inconclusive"
   ],
   "title": "Classification",
   "type": "string"
  },
  "CorrelationLink": {
   "additionalProperties": false,
   "properties": {
    "other_report_id": {
     "title": "Other Report Id",
     "type": "string"
    },
    "other_created_at": {
     "title": "Other Created At",
     "type": "string"
    },
    "other_classification": {
     "title": "Other Classification",
     "type": "string"
    },
    "shared": {
     "description": "Shared indicator types and display values",
     "items": {
      "type": "string"
     },
     "title": "Shared",
     "type": "array"
    },
    "method": {
     "enum": [
      "exact_indicator",
      "message_similarity",
      "brand_pattern",
      "infrastructure"
     ],
     "title": "Method",
     "type": "string"
    },
    "score": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Similarity in percent (0-100) for message_similarity only",
     "title": "Score"
    }
   },
   "required": [
    "other_report_id",
    "other_created_at",
    "other_classification",
    "shared",
    "method"
   ],
   "title": "CorrelationLink",
   "type": "object"
  },
  "Coverage": {
   "additionalProperties": false,
   "properties": {
    "applicable": {
     "title": "Applicable",
     "type": "integer"
    },
    "succeeded": {
     "title": "Succeeded",
     "type": "integer"
    },
    "failed": {
     "title": "Failed",
     "type": "integer"
    },
    "unavailable": {
     "title": "Unavailable",
     "type": "integer"
    },
    "skipped": {
     "title": "Skipped",
     "type": "integer"
    },
    "essential_missing": {
     "items": {
      "type": "string"
     },
     "title": "Essential Missing",
     "type": "array"
    }
   },
   "required": [
    "applicable",
    "succeeded",
    "failed",
    "unavailable",
    "skipped",
    "essential_missing"
   ],
   "title": "Coverage",
   "type": "object"
  },
  "Finding": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "description": "Unique within the report, e.g. 'url.homograph' or 'tls.expired#2'",
     "title": "Id",
     "type": "string"
    },
    "code": {
     "description": "Stable rule code, e.g. 'url.homograph'",
     "title": "Code",
     "type": "string"
    },
    "module": {
     "$ref": "#/$defs/Module"
    },
    "title": {
     "title": "Title",
     "type": "string"
    },
    "observed": {
     "description": "The observed fact in plain language",
     "title": "Observed",
     "type": "string"
    },
    "evidence": {
     "additionalProperties": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "integer"
       },
       {
        "type": "boolean"
       },
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "items": {
         "type": "integer"
        },
        "type": "array"
       },
       {
        "items": {
         "additionalProperties": true,
         "type": "object"
        },
        "type": "array"
       },
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": "Evidence",
     "type": "object"
    },
    "source": {
     "description": "Check or provider that produced the finding",
     "title": "Source",
     "type": "string"
    },
    "provenance": {
     "$ref": "#/$defs/Provenance",
     "default": "live"
    },
    "observed_at": {
     "title": "Observed At",
     "type": "string"
    },
    "severity": {
     "$ref": "#/$defs/Severity"
    },
    "strength": {
     "$ref": "#/$defs/Strength"
    },
    "impact": {
     "title": "Impact",
     "type": "string"
    },
    "recommendation": {
     "title": "Recommendation",
     "type": "string"
    },
    "limitation": {
     "title": "Limitation",
     "type": "string"
    }
   },
   "required": [
    "id",
    "code",
    "module",
    "title",
    "observed",
    "source",
    "observed_at",
    "severity",
    "strength",
    "impact",
    "recommendation",
    "limitation"
   ],
   "title": "Finding",
   "type": "object"
  },
