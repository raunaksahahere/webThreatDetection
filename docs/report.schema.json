  "Severity": {
   "enum": [
    "info",
    "low",
    "medium",
    "high",
    "critical"
   ],
   "title": "Severity",
   "type": "string"
  },
  "Strength": {
   "description": "How much a finding can carry the classification on its own.\n\nweak: language or heuristic signal (urgency, keyword, missing header).\nmoderate: structural signal with a plausible benign explanation (new domain, lookalike).\nstrong: specific, hard-to-explain signal (homograph of a protected brand, credential form\n        posting to a third party, chain to a distrusted CA).\nauthoritative: listing in an authoritative intelligence source with an exact match.",
   "enum": [
    "weak",
    "moderate",
    "strong",
    "authoritative"
   ],
   "title": "Strength",
   "type": "string"
  }
 },
