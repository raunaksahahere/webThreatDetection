  "Indicator": {
   "additionalProperties": false,
   "properties": {
    "type": {
     "enum": [
      "url",
      "domain",
      "ip",
      "email",
      "phone",
      "upi",
      "crypto_wallet",
      "brand",
      "cert_spki"
     ],
     "title": "Type",
     "type": "string"
    },
    "display": {
     "description": "Safe display value (defanged URL, masked phone/email)",
     "title": "Display",
     "type": "string"
    },
    "match_key": {
     "description": "Normalized value, or keyed HMAC for personal identifiers",
     "title": "Match Key",
     "type": "string"
