{
  "manifest_version": 3,
  "name": "WTD Companion (link & page check)",
  "version": "0.2.0",
  "description": "Check the current page or a link with your local WTD investigation server; optional warning before opening risky pages (off by default).",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Check this page with WTD",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "optional_permissions": [
    "webNavigation"
  ]
}
