# Copy to .env and fill in. Never commit .env. Values are read at startup and never logged.

# Threat intelligence (optional but recommended). Free key from your own abuse.ch account: https://auth.abuse.ch/
# URLhaus terms: not-for-profit use; data must not be redistributed or used to train/validate AI models.
# Optional: dashboard visitors can use their own key instead (header "urlhaus" pill; kept in their browser tab only).
URLHAUS_AUTH_KEY=

# AI explanations. Providers are tried in WTD_AI_PROVIDERS order; any that is not configured is skipped.
WTD_AI_PROVIDERS=gemini,openrouter,local
# Gemini (Google AI Studio key). Models are tried in order: one over its quota (429) hands over to the next.
GEMINI_API_KEY=
WTD_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Only FREE OpenRouter models are allowed by this deployment (the code refuses others).
# OPENROUTER_API_KEY may also be set in your shell environment instead of here.
OPENROUTER_API_KEY=
WTD_AI_ENABLED=1
WTD_AI_MODEL=xingchen-agi/xing4.0-29b-a4b:free
# Local fallback via Ollama (optional): `ollama pull qwen3:4b`
WTD_AI_LOCAL_MODEL=qwen3:4b
WTD_AI_TIMEOUT=45

# Dashboard/API operator token. If empty, a random token is generated in data/api_token on first start.
WTD_API_TOKEN=

# Local chain (anvil). The backend uses anvil's public test key for account #1 ONLY on chain id 31337.
WTD_RPC_URL=http://127.0.0.1:8545
# Required for any non-local chain (never use anvil test keys elsewhere):
WTD_REPORTER_KEY=

# Limits
WTD_RATE_PER_MIN=12

# Public demo: 1 = no operator token needed (anyone with the link can use every feature). The token still works and
# lifts the quotas. On-chain register/revise/review stay token-only unless the chain is the local/embedded one (31337).
WTD_PUBLIC_DEMO=0
WTD_PUBLIC_SESSION_LIMIT=15
WTD_PUBLIC_DAILY_LIMIT=60

# Hosting (see docs/DEPLOY.md)
# Reviewer account for independent review on non-local chains (must differ from the reporter):
WTD_REVIEWER_KEY=
# Comma-separated dashboard origins allowed to call this API cross-origin (e.g. the Vercel URL). Empty = same-origin only.
WTD_CORS_ORIGINS=
# Stable keyed-hash secret for indicators (containers); empty = random key in data/indicator_hmac.key
WTD_HMAC_KEY=
